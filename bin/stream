#!/bin/bash
# Watch the current controller live in a browser: bin/stream start|stop|status
# Runs Webots in realtime with the w3d streaming server and restarts it whenever a run ends,
# so a page reload always shows the controller that is checked out now.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WEBOTS="${WEBOTS_BIN:-/Applications/Webots.app/Contents/MacOS/webots}"
[ -x "$WEBOTS" ] || WEBOTS="$(command -v webots)"
[ -x "$WEBOTS" ] || { echo "Webots not found. Install Webots R2025a or set WEBOTS_BIN."; exit 1; }
PIDFILE="$ROOT/runs/stream.pid"
cfg() { python3 -c "import json,sys;print(json.load(open('$ROOT/project.json')).get(sys.argv[1],sys.argv[2]))" "$1" "$2"; }
PORT="$(cfg stream_port 1234)"              # tailnet port: tailscale serve --http=$PORT -> 127.0.0.1:$LOCAL_PORT
LOCAL_PORT="$(cfg stream_local_port 1236)"  # Webots listens here. It must differ from $PORT: tailscale serve holds
                                            # <tailnet ip>:$PORT, so Webots cannot bind *:$PORT and silently moves to $PORT+1.
PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"   # tailscale is not on the PATH of a non-interactive ssh shell
TSHOST="$(tailscale status --json 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin)['Self']['DNSName'].rstrip('.'))" 2>/dev/null)"  # tailnet name; serve ignores requests by bare IP
code() { curl -s -o /dev/null -m 3 -w '%{http_code}' "$1"; }
WORLD="${STREAM_WORLD:-$ROOT/$(cfg world '')}"   # STREAM_WORLD=/abs/path.wbt shows another world

case "${1:-status}" in
  start)
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && { echo "already running (pid $(cat "$PIDFILE"))"; exit 0; }
    mkdir -p "$ROOT/runs"
    nohup "$0" _loop >"$ROOT/runs/stream.log" 2>&1 &
    echo $! >"$PIDFILE"
    for _ in $(seq 30); do [ "$(code "http://127.0.0.1:$LOCAL_PORT/index.html")" = 200 ] && break; sleep 1; done
    if [ "$(code "http://127.0.0.1:$LOCAL_PORT/index.html")" != 200 ]; then
      echo "stream FAILED: nothing answers on 127.0.0.1:$LOCAL_PORT after 30 s. runs/stream.log:"; tail -5 "$ROOT/runs/stream.log"
      "$0" stop >/dev/null; exit 1
    fi
    echo "stream: http://${TSHOST:-<tailnet host>}:$PORT/index.html (local: http://127.0.0.1:$LOCAL_PORT/index.html)"
    [ -n "$TSHOST" ] && [ "$(code "http://$TSHOST:$PORT/index.html")" != 200 ] &&
      echo "WARNING: tailnet port $PORT does not reach it. Fix: tailscale serve --bg --http=$PORT http://127.0.0.1:$LOCAL_PORT"
    exit 0
    ;;
  _loop)
    trap 'kill "$child" 2>/dev/null; exit 0' TERM INT
    while true; do
      rm -rf "$HOME/Library/Saved Application State/com.cyberbotics.webots.savedState"
      TRIAL_SIM_SECONDS="${STREAM_SIM_SECONDS:-600}" "$WEBOTS" --batch --minimize --stdout --stderr \
        --mode=realtime --stream --port="$LOCAL_PORT" "$WORLD" &
      child=$!
      wait "$child"
      sleep 2
    done
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
      pid="$(cat "$PIDFILE")"; kill "$pid" 2>/dev/null; sleep 1
      pkill -f "webots .*--stream --port=$LOCAL_PORT" 2>/dev/null
      rm -f "$PIDFILE"; echo stopped
    else echo "not running"; fi
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "running (pid $(cat "$PIDFILE")) http://${TSHOST:-<tailnet host>}:$PORT/index.html"
    else echo "not running"; fi
    ;;
  *) echo "usage: bin/stream start|stop|status"; exit 2 ;;
esac
